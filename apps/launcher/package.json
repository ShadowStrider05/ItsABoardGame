{
  "name": "@itsaboardgame/launcher",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc -p tsconfig.json",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "lint": "echo \"No linter configured yet for launcher\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@electron/get": "^2.0.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.8.7",
    "electron": "31.7.5",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.wildhavengames.itsaboardgame.launcher",
    "productName": "ItsABoardGameLauncher",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release-builder"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
